# Elastic Beanstalk single-instance environments create and attach their own
# security group in addition to SecurityGroups configured on the launch
# configuration. Override that generated group so it does not expose nginx
# directly to the internet.
Resources:
  AWSEBSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: CloudFront-only HTTP ingress for Nissan OEE
      VpcId:
        Fn::GetOptionSetting:
          Namespace: aws:ec2:vpc
          OptionName: VPCId
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 80
          ToPort: 80
          SourcePrefixListId:
            Fn::GetOptionSetting:
              Namespace: aws:elasticbeanstalk:application:environment
              OptionName: CLOUDFRONT_ORIGIN_PREFIX_LIST_ID
